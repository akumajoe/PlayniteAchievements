<UserControl x:Class="PlayniteAchievements.Views.Workshop.Preview.ShowcasePreviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:PlayniteAchievements.Views.Helpers"
             xmlns:controls="clr-namespace:PlayniteAchievements.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="480" d:DesignWidth="560">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <helpers:SharedResourceDictionary Source="pack://application:,,,/PlayniteAchievements;component/Resources/PlayAchImplicitControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding PageName}"
                   Foreground="{DynamicResource PlayAch.Brush.Text}"
                   FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis"
                   Margin="0,0,0,10"/>

        <!-- The page's grid on a 16:9 canvas: each block at its row, column and span. -->
        <controls:AspectRatioGrid x:Name="LayoutGrid"
                                  Margin="0,0,0,6"
                                  AspectRatio="1.7777777777777777"/>

        <!-- The images the page bundles. -->
        <ItemsControl x:Name="ImageList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="160" Height="90"
                            Margin="0,0,8,8"
                            CornerRadius="3"
                            ClipToBounds="True"
                            Background="{DynamicResource PlayAch.Brush.Surface}"
                            BorderBrush="{DynamicResource PlayAch.Brush.Border}"
                            BorderThickness="{StaticResource PlayAch.Thickness.Border}">
                        <Image Width="158" Height="88"
                               helpers:AsyncImage.Uri="{Binding}"
                               helpers:AsyncImage.DecodePixel="320"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
