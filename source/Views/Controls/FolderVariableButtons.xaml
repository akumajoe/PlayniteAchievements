<UserControl x:Class="PlayniteAchievements.Views.Controls.FolderVariableButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:PlayniteAchievements.Common">
    <ItemsControl ItemsSource="{x:Static common:FolderPathVariables.All}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Content="{Binding Token}" ToolTip="{Binding Description}"
                        Click="InsertVariable_Click" Focusable="False"
                        Padding="8,4" Margin="0,4,6,0"/>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
